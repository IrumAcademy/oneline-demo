# 이 파일은 "금고에 무엇이 들어 있어야 하는지" 알려주는 목록입니다.
# 실제 값은 .env.local 에 적고, .env.local 은 저장소에 올리지 않습니다.
#
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ 이 붙으면 브라우저에서 그대로 보입니다.
# 비밀 값에는 절대 붙이지 마세요. (④회차에서 다룹니다)

NEXT_PUBLIC_SITE_NAME=오늘의 한 줄

# ③회차에서 만든 창고 주소와 열쇠입니다.
# Supabase → Project Settings → Data API 에서 복사하세요.
#
# 이 둘은 NEXT_PUBLIC_ 이 붙어 브라우저에 그대로 보입니다.
# 보여도 괜찮게 설계된 값입니다 — 진짜 자물쇠는 창고의 RLS 가 겁니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠ service_role key 는 여기에도, 어디에도 NEXT_PUBLIC_ 을 붙이지 마세요.
#   그 키는 RLS 를 통째로 무시합니다. (④회차 「금고」 참고)
